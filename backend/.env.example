# Application
APP_NAME=AI SOC ANALYSIS SYSTEM
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-secret-key
API_PREFIX=/api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://soc_user:soc_password@localhost:5432/soc_copilot

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# LLM Providers
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Embeddings
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=security_knowledge

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.json,.csv,.log

# Rate limiting
RATE_LIMIT=60/minute

# Render / low memory: use SimpleVectorStore (auto-enabled when RENDER=true)
LIGHTWEIGHT_RAG=false
